---
import { getCollection } from 'astro:content'

const { all: polls } = await getCollection('polls')
const pollId = Astro.params.slug

// Find the matching poll by slug (filename without .md)
const poll = polls.find(p => 
  p.id === pollId || 
  p.fileSlug === pollId || 
  p.slug === pollId
)

if (!poll) {
  throw Astro.redirect('/polls', 301)
}

// Extract the filename from the slug
const fileName = poll.fileSlug || `${pollId}.md`

// Read the poll content to get question and options
const pollContent = await Bun.file(`src/content/polls/${fileName}`).text()

// Simple parsing - in a real implementation, use a markdown parser
const lines = pollContent.split('\n')
let question = ''
const options = []

// Look for the first substantial line as question
for (const line of lines) {
  const trimmed = line.trim()
  if (trimmed && !trimmed.startsWith('#') && !trimmed.startsWith('---') && trimmed.length > 10) {
    question = trimmed
    break
  }
}

// Look for options (lines that might be choices)
// This is a simplified parser - adjust based on actual markdown structure
const optionMatches = pollContent.match(/- (.+)/g)
if (optionMatches) {
  options.push(...optionMatches.slice(0, 4).map(m => m.replace('- ', '')))
}

if (options.length === 0) {
  options = ['Option A', 'Option B']
}
