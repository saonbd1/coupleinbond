---
import { getCollection } from 'astro:content';
import BlogIndex from '../components/BlogIndex.astro';
import { DEFAULT_PAGE_SIZE, pageCount, pageSlice } from '../lib/pagination';

// Blog index. Reproduces public/blog.html exactly: same shell, same
// featured post, same card grid (newest first via cardOrder) and the
// same Blog/ItemList/Organization JSON-LD (ItemList ordered by ldOrder,
// which is a separate hand-maintained order from the visible grid).
//
// The listing is paginated: this file emits page 1 (/blog.html) and
// src/pages/blog/page/[page].astro emits the rest (/blog/page/2.html, ...).
// src/pages/blog/size/[size].astro emits the same listing with a different
// number of posts per page (8 or 10).

const all = await getCollection('blog');
const posts = all.filter((p) => !p.data.draft)
  .sort((a, b) => b.data.cardOrder - a.data.cardOrder);
// The ItemList JSON-LD keeps its own hand-maintained order (ldOrder),
// independent of the visible grid order.
const ldPosts = all.filter((p) => !p.data.draft)
  .sort((a, b) => a.data.ldOrder - b.data.ldOrder);

const totalPages = pageCount(posts.length, DEFAULT_PAGE_SIZE);
---
<BlogIndex
  posts={pageSlice(posts, 1, DEFAULT_PAGE_SIZE)}
  page={1}
  totalPages={totalPages}
  allPosts={ldPosts}
  pageSize={DEFAULT_PAGE_SIZE}
  totalPosts={posts.length}
/>

