---
// Blog post layout. Reproduces the original hand-written page shell exactly:
// same <head> tags, same nav/article/footer markup, same relative asset paths.
interface Props {
  post: any;
}
const { post } = Astro.props;
const d = post.data;

const SITE = 'https://couplein.bond';
const url = `${SITE}/blog-posts/${post.id}.html`;
const pageLabel = `${d.pageTitle} — Couple in Bond`;
const socialImage = `${SITE}/assets/social-share.jpg`;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: d.title,
  description: d.schemaDescription,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: socialImage,
  datePublished: d.datePublished,
  dateModified: d.dateModified,
  author: { '@type': 'Organization', name: d.author, url: `${SITE}/blog.html` },
  publisher: {
    '@type': 'Organization',
    name: 'Couple in Bond',
    url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: socialImage },
  },
  articleSection: d.section,
  keywords: d.keywords,
  inLanguage: 'en',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${url}#breadcrumbs`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE}/blog.html` },
    { '@type': 'ListItem', position: 2, name: pageLabel, item: url },
  ],
};
---
<!-- Current CoupleIn theme reminder: preserve the pink-to-lilac gradient, rounded white cards, coral/plum accents, and playful relationship tone. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageLabel}</title>
  <link rel="stylesheet" href="../blog.css"><script src="../blog-nav.js" defer></script>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting, null, 2)}></script>
          <meta name="description" content={d.description}>
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#ff4d6d">
  <link rel="canonical" href={url}>
  <link rel="icon" href="../assets/coupleinbond-favicon.png">
  <link rel="apple-touch-icon" href="../assets/coupleinbond-favicon.png">
  <meta property="og:title" content={pageLabel}>
  <meta property="og:description" content={d.description}>
  <meta property="og:url" content={url}>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Couple in Bond">
  <meta property="og:locale" content="en_US">
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:alt" content="Couple in Bond relationship tools and bonding ideas">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageLabel}>
  <meta name="twitter:description" content={d.description}>
  <meta name="twitter:image" content={socialImage}>

<script type="application/ld+json" data-seo-enhancement set:html={JSON.stringify(breadcrumb)}></script>
</head>
<body>
  <div class="blog-shell"><div class="blog-wrap">
    <header class="blog-nav" data-root=".."><a class="blog-brand" href="../index.html">💕 Couple in Bond</a><nav class="blog-nav-links" aria-label="Article navigation"><a href="../blog.html">Blog</a><a href="../calculator.html">Calculator</a><a href="../privacy.html">Privacy</a></nav></header>
    <main class="article-layout"><article class="article-shell"><header class="article-header"><div class="blog-kicker">{d.kicker}</div><h1>{d.title}</h1><p class="article-dek">{d.dek}</p><div class="article-meta"><span>{d.publishedLabel}</span><span>·</span><span>By {d.author}</span></div></header><div class="article-body"><slot /></div><footer class="article-footer">{d.disclaimer}</footer></article>{d.asideHtml && <Fragment set:html={d.asideHtml} />}</main>
    <footer class="blog-footer"><p>© 2026 Couple in Bond. All rights reserved.</p><p><a href="../blog.html">More relationship ideas</a></p></footer>
  </div></div>
</body>
</html>
