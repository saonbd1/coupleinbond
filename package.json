{
  "name": "coupleinbond",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/copy-bn-static.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:localized": "node scripts/generate-localized-content.mjs",
    "validate:localized": "node scripts/validate-localized-content.mjs",
    "generate:bn": "node scripts/generate-bn-content.mjs",
    "validate:bn": "node scripts/validate-bn-content.mjs",
    "content:check": "npm run generate:localized && npm run validate:localized",
