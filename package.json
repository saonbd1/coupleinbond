{
  "name": "coupleinbond",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/update-home-latest.mjs",
    "update:home-latest": "node scripts/update-home-latest.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:localized": "node scripts/generate-localized-content.mjs",
    "validate:localized": "node scripts/validate-localized-content.mjs",
    "content:check": "npm run generate:localized && npm run validate:localized",
    "quotes:generate": "node scripts/generate-quote-cards.mjs",
    "quotes:check": "node scripts/generate-quote-cards.mjs --check",
    "sitemap:lastmod": "node scripts/sitemap-lastmod.mjs",
    "verify:seo": "node scripts/verify-hreflang.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:pagination": "node scripts/verify-blog-pagination.mjs && node scripts/verify-polls-pagination.mjs",
    "validate:release": "npm run content:check && npm run quotes:generate && npm run build && npm run verify:seo && npm run verify:links && npm run verify:pagination"
  },
  "dependencies": {
    "@vercel/connect": "^2.3.6",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
